<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="860" prefHeight="740" styleClass="fondo">
    <Label text="NicaData Solutions S.A." styleClass="titulo"
           AnchorPane.topAnchor="24" AnchorPane.leftAnchor="28"/>
    <Label text="Procesamiento de registros" styleClass="subtitulo"
           AnchorPane.topAnchor="61" AnchorPane.leftAnchor="28"/>
    <TabPane fx:id="tabPrincipal" tabClosingPolicy="UNAVAILABLE"
             AnchorPane.topAnchor="100" AnchorPane.leftAnchor="24"
             AnchorPane.rightAnchor="24" AnchorPane.bottomAnchor="24">
        <tabs>
            <Tab text="Práctica: un hilo">
                <content><fx:include fx:id="practica" source="procesador-view.fxml"/></content>
            </Tab>
            <Tab text="Reto final: dos hilos">
                <content><fx:include fx:id="reto" source="monitor-view.fxml"/></content>
            </Tab>
        </tabs>
    </TabPane>
</AnchorPane>
